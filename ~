#include <stdio.h>

void fahr_to_celsius(float min, float max, float interval){

    printf("\nFahrenheit\t>\tCelsius\n________________________________\n");
    
    for(float fahr = min; fahr <= max ; fahr += interval){
        float celsius = (5.0 * ((fahr*1.0) - 32.0) / 9.0);
        printf("%3.0f\t\t>\t%6.1f\n", fahr, celsius);
    }
    
    printf("________________________________\n\n");
}


int main() {
    fahr_to_celsius(0, 300, 20);   
    return 0;
}
